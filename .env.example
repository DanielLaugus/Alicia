# Copy to .env and fill locally. Never commit real secrets.

# --- Bot / strategy ---
BOT_CAPITAL_EUR=2000
RISK_PCT=0.02
MAX_SMALL_NOTIONAL_EUR=200
FEE_BPS=10
SLIPPAGE_BPS=5
MONTHLY_DD_HALT=0.10

# Market
SYMBOL=BTC/USDT
EXCHANGE=binance

# Public OHLCV cache (gitignored). No API key required.
DATA_CACHE_DIR=data/cache

# Event-day pauses (CPI / FOMC / NFP). Extra dates: EVENTS_PATH JSON.
PAUSE_CPI=true
PAUSE_FED=true
PAUSE_NFP=true
EVENTS_PATH=data/events.example.json

# Runtime mode: backtest | paper | live
# live requires keys and is still spot buy/sell only — no withdrawals exist in this codebase.
ALICIA_MODE=backtest

# --- Exchange keys (paper/live only; leave empty for backtest/dry-run) ---
# Create an API key with READ + TRADE only. Never enable withdrawal.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Optional: raise if a request takes longer than this (ms)
API_LATENCY_MS_LIMIT=5000
